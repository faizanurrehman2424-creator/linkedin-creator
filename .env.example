# Next.js App URL (Set to your Hetzner IP e.g. http://123.45.67.89:3000 or your domain)
NEXT_PUBLIC_APP_URL="http://your-server-ip:3000"
APP_URL="http://your-server-ip:3000"

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI / Google Vertex AI (Gemini via ADC or API)
GOOGLE_CLOUD_PROJECT="your-google-cloud-project-id"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/credentials.json"

# Apify (LinkedIn Profile Scraping)
APIFY_API_KEY="your-apify-key"

# SMTP Credentials (Email Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_TO=""

# LinkedIn API (For OAuth and Direct Publishing)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"

# Admin Authentication
ADMIN_NAME="faizan"
ADMIN_PASSWORD="your-secure-admin-password"
ADMIN_JWT_SECRET="your-secure-random-jwt-secret"

# Veo3 Video Generation
VEO3_API_KEY="your-veo3-api-key"

# Master Admin Toggles (global feature overrides)
ADMIN_IDEA_GEN_ENABLED="true"
ADMIN_IMAGE_GEN_ENABLED="true"
ADMIN_VIDEO_GEN_ENABLED="true"
ADMIN_APIFY_ENABLED="true"

# Cron Job Secret
CRON_SECRET="your-random-cron-secret"
